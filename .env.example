# --- Official Personal API (23 tools, no password) ---
#
# Optional: set this instead of running `garmin-mcp-save-key`. Takes
# precedence over the saved key file. Generate it at Garmin Connect's
# website: Settings -> Personal API Key -> Create Key.
GARMIN_PERSONAL_API_KEY=

# --- Unofficial fallback (20 tools: 11 read-only + 9 workout, only if you want them) ---
#
# Only used by `garmin-mcp-auth`, the one-time interactive login script.
# The MCP server itself (garmin-mcp-server) never reads these — it only
# ever resumes the cached session token, so these never need to be set
# while Claude or Cursor is running.
#
# Leaving these unset is fine too: garmin-mcp-auth will just prompt you
# for email/password (and MFA code, if your account uses it) interactively.

GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the unofficial-fallback session token is cached after login.
# Defaults to ~/.garminconnect if unset. Treat this file like a password.
GARMINTOKENS=

# --- Remote server only (garmin-mcp-remote-server) ---
#
# These three are read by the *remote*, HTTP-based server — the one you'd
# deploy somewhere like Railway or Render so claude.ai can reach it from
# your phone, not the local garmin-mcp-server above. The 23 official-API
# tools always work here; it never reads GARMIN_EMAIL/GARMIN_PASSWORD, and
# your Garmin password should never be set as an environment variable on a
# remote host. See the "Remote server" section of README.md. The 11
# unofficial and 9 workout tools are also registered here, but stay off
# until you opt in at this server's own /admin/garmin-login page (see
# GARMIN_UNOFFICIAL_SESSION below) — that page is the only place your
# Garmin password is ever typed for this server.

# Same Garmin Personal API key as above, but set directly as an env var —
# there's no interactive terminal on a deploy to run `garmin-mcp-save-key`.
GARMIN_PERSONAL_API_KEY=

# This server's own public HTTPS URL once deployed, e.g.
# https://garmin-mcp.up.railway.app (no trailing slash). Used as the OAuth
# issuer and for Host-header validation.
GARMIN_MCP_PUBLIC_URL=

# A password *you* choose to gate who can get a token for this server.
# Unrelated to, and never shared with, your Garmin account password.
GARMIN_MCP_ACCESS_PASSWORD=

# --- Remote server, unofficial fallback + workout tools (optional, higher risk) ---
#
# Leave this unset unless you've deliberately logged in at this server's
# /admin/garmin-login page (gated by GARMIN_MCP_ACCESS_PASSWORD above) and
# want the resulting session to survive a restart/redeploy without
# revisiting that page. This is an opaque session token, NOT your Garmin
# password -- the server never reads GARMIN_EMAIL/GARMIN_PASSWORD, and
# your actual password should never be set as an environment variable on
# a remote host. Enables both the 11 read-only unofficial tools and the 9
# workout tools (create/schedule/push/delete a workout) -- see the
# "Unofficial fallback tools on the remote server" section of README.md
# before using this at all.
GARMIN_UNOFFICIAL_SESSION=
