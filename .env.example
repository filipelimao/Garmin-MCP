# --- Official Personal API (23 tools, no password) ---
#
# Optional: set this instead of running `garmin-mcp-save-key`. Takes
# precedence over the saved key file. Generate it at Garmin Connect's
# website: Settings -> Personal API Key -> Create Key.
GARMIN_PERSONAL_API_KEY=

# --- Unofficial fallback (11 tools, only if you want them) ---
#
# Only used by `garmin-mcp-auth`, the one-time interactive login script.
# The MCP server itself (garmin-mcp-server) never reads these — it only
# ever resumes the cached session token, so these never need to be set
# while Claude or Cursor is running.
#
# Leaving these unset is fine too: garmin-mcp-auth will just prompt you
# for email/password (and MFA code, if your account uses it) interactively.

GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the unofficial-fallback session token is cached after login.
# Defaults to ~/.garminconnect if unset. Treat this file like a password.
GARMINTOKENS=

# --- Remote server only (garmin-mcp-remote-server) ---
#
# These three are read by the *remote*, HTTP-based server — the one you'd
# deploy somewhere like Railway so claude.ai can reach it from your phone,
# not the local garmin-mcp-server above. It only ever exposes the 23
# official-API tools; it never reads GARMIN_EMAIL/GARMIN_PASSWORD, and your
# Garmin password should never be set as an environment variable on a
# remote host. See the "Remote server" section of README.md.

# Same Garmin Personal API key as above, but set directly as an env var —
# there's no interactive terminal on a deploy to run `garmin-mcp-save-key`.
GARMIN_PERSONAL_API_KEY=

# This server's own public HTTPS URL once deployed, e.g.
# https://garmin-mcp.up.railway.app (no trailing slash). Used as the OAuth
# issuer and for Host-header validation.
GARMIN_MCP_PUBLIC_URL=

# A password *you* choose to gate who can get a token for this server.
# Unrelated to, and never shared with, your Garmin account password.
GARMIN_MCP_ACCESS_PASSWORD=
